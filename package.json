{
  "name": "esp32-a1-audio-lab",
  "version": "0.8.3",
  "private": true,
  "type": "module",
  "description": "Local Web Serial audio workbench for compatible ESP32-A1 debug firmware",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/quality/*.test.mjs",
    "build": "node build.mjs",
    "test:quality": "node --test tests/quality/*.test.mjs",
    "test:browser": "python tests/quality/server.py"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "fast-check": "4.10.2",
    "gremlins.js": "2.2.0"
  }
}
